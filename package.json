{
  "name": "onboarding-kb-assistant",
  "version": "1.0.0",
  "description": "员工入职知识库问答助手 - SAP CAP + Claude AI",
  "main": "srv/server.js",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "cds build",
    "test": "jest",
    "watch-kb-manager": "cds watch --open kbmanager/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@cap-js/hana": "^1",
    "@sap-ai-sdk/ai-api": "^2.9.0",
    "@sap-ai-sdk/foundation-models": "^2.9.0",
    "@sap-ai-sdk/orchestration": "^2.9.0",
    "@sap/cds": "^8",
    "cds-plugin-ui5": "^0.13.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "jest": "^29"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "watch": {
      "ignore": [
        "db.sqlite"
      ]
    },
    "features": {
      "fiori_routes": true
    },
    "roots": [
      "db",
      "srv",
      "app"
    ]
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/kb-manager"
  ]
}
